{
  "schema": 2,
  "name": "Login + Measurement Wizard",
  "onFailure": "stop",
  "steps": [
    { "name": "Wait for username field", "screen": "Login", "action": "waitFor", "locatorType": "text", "locator": "Enter username", "timeoutSec": 15 },
    { "name": "Enter username", "screen": "Login", "action": "type", "locatorType": "text", "locator": "Enter username", "text": "walterf25" },
    { "name": "Wait for PIN field", "screen": "Login", "action": "waitFor", "locatorType": "text", "locator": "Enter 4-digit PIN", "timeoutSec": 10 },
    { "name": "Enter PIN", "screen": "Login", "action": "type", "locatorType": "text", "locator": "Enter 4-digit PIN", "text": "0902" },
    { "screen": "Login", "action": "screenshot", "name": "LoginScreen" },
    { "name": "Wait for Log in button", "screen": "Login", "action": "waitFor", "locatorType": "text", "locator": "Log in", "timeoutSec": 10 },
    { "name": "Tap Log in", "screen": "Login", "action": "tap", "locatorType": "text", "locator": "Log in" },
    { "screen": "Login", "action": "sleep", "ms": 500 },
    { "screen": "Login", "action": "screenshot", "name": "AfterLogin" },
    { "name": "Tap Take my measurements", "screen": "Main Menu", "action": "tap", "locatorType": "text", "locator": "Take my measurements" },
    { "screen": "Main Menu", "action": "sleep", "ms": 500 },
    { "screen": "Main Menu", "action": "screenshot", "name": "afterMainMenu" },
    { "name": "Tap Start my experience", "screen": "Start Experience", "action": "tap", "locatorType": "text", "locator": "Start my experience" },
    { "screen": "Start Experience", "action": "sleep", "ms": 500 },
    { "screen": "Start Experience", "action": "screenshot", "name": "afterStartmyExperience" },
    { "name": "Tap Skip", "screen": "Skip Tutorial", "action": "tap", "locatorType": "text", "locator": "Skip" },
    { "screen": "Skip Tutorial", "action": "sleep", "ms": 500 },
    { "screen": "Skip Tutorial", "action": "screenshot", "name": "afterSkip" },
    { "name": "Tap camera shutter", "screen": "Camera", "action": "tap", "locatorType": "uiSelector", "locator": "new UiSelector().className(\"android.widget.Button\").instance(1)" },
    { "screen": "Camera", "action": "screenshot", "name": "takepicturepressed" },
    { "name": "Wait for Timer", "screen": "Camera", "action": "waitFor", "locatorType": "text", "locator": "Timer", "timeoutSec": 10 },
    { "name": "Tap Timer", "screen": "Camera", "action": "tap", "locatorType": "text", "locator": "Timer" },
    { "screen": "Camera", "action": "screenshot", "name": "TimerClicked" },
    { "name": "Tap OK", "screen": "Camera", "action": "tap", "locatorType": "text", "locator": "OK" },
    { "name": "Tap camera shutter again", "screen": "Camera", "action": "tap", "locatorType": "uiSelector", "locator": "new UiSelector().className(\"android.widget.Button\").instance(1)" },
    { "name": "Wait for Save", "screen": "Camera", "action": "waitFor", "locatorType": "text", "locator": "Save", "timeoutSec": 30 },
    { "screen": "Camera", "action": "screenshot", "name": "PictureTaken" },
    { "name": "Tap Save", "screen": "Camera", "action": "tap", "locatorType": "text", "locator": "Save" },
    { "name": "Tap Next", "screen": "Shoe Selection", "action": "tap", "locatorType": "text", "locator": "Next" },
    { "screen": "Shoe Selection", "action": "screenshot", "name": "Shoe Selection" },
    { "name": "Tap Flat shoes <1”", "screen": "Shoe Selection", "action": "tap", "locatorType": "text", "locator": "Flat shoes <1”" },
    { "screen": "Shoe Selection", "action": "screenshot", "name": "Flat Shoes Pressed" },
    { "name": "Tap Next →", "screen": "Side View", "action": "tap", "locatorType": "text", "locator": "Next →" },
    { "screen": "Side View", "action": "sleep", "ms": 500 },
    { "screen": "Side View", "action": "screenshot", "name": "Side View Measurements" },
    { "name": "Wait for Next →", "screen": "Side View", "action": "waitFor", "locatorType": "text", "locator": "Next →", "timeoutSec": 30 },
    { "name": "Tap Next →", "screen": "Eye Height", "action": "tap", "locatorType": "text", "locator": "Next →" },
    { "screen": "Eye Height", "action": "sleep", "ms": 500 },
    { "screen": "Eye Height", "action": "screenshot", "name": "Eye Height" },
    { "name": "Wait for Next →", "screen": "Eye Height", "action": "waitFor", "locatorType": "text", "locator": "Next →", "timeoutSec": 30 },
    { "name": "Tap Next →", "screen": "Elbow Height", "action": "tap", "locatorType": "text", "locator": "Next →" },
    { "screen": "Elbow Height", "action": "sleep", "ms": 500 },
    { "screen": "Elbow Height", "action": "screenshot", "name": "Elbow Height" },
    { "name": "Wait for Next →", "screen": "Elbow Height", "action": "waitFor", "locatorType": "text", "locator": "Next →", "timeoutSec": 30 },
    { "name": "Tap Next →", "screen": "Lumbar Height", "action": "tap", "locatorType": "text", "locator": "Next →" },
    { "screen": "Lumbar Height", "action": "sleep", "ms": 500 },
    { "screen": "Lumbar Height", "action": "screenshot", "name": "Lumbar Height" },
    { "name": "Wait for Next →", "screen": "Lumbar Height", "action": "waitFor", "locatorType": "text", "locator": "Next →", "timeoutSec": 30 },
    { "name": "Tap Next →", "screen": "Buttocks Height", "action": "tap", "locatorType": "text", "locator": "Next →" },
    { "screen": "Buttocks Height", "action": "sleep", "ms": 500 },
    { "screen": "Buttocks Height", "action": "screenshot", "name": "Buttocks Height" },
    { "name": "Wait for Next →", "screen": "Buttocks Height", "action": "waitFor", "locatorType": "text", "locator": "Next →", "timeoutSec": 30 },
    { "name": "Tap Next →", "screen": "Knee Height", "action": "tap", "locatorType": "text", "locator": "Next →" },
    { "screen": "Knee Height", "action": "sleep", "ms": 500 },
    { "screen": "Knee Height", "action": "screenshot", "name": "Knee Height" },
    { "name": "Wait for View my recommendations", "screen": "Knee Height", "action": "waitFor", "locatorType": "text", "locator": "View my recommendations", "timeoutSec": 30 },
    { "name": "Tap View my recommendations", "screen": "Recommendations", "action": "tap", "locatorType": "text", "locator": "View my recommendations" },
    { "screen": "Recommendations", "action": "sleep", "ms": 500 },
    { "screen": "Recommendations", "action": "screenshot", "name": "Recommendations" }
  ]
}
